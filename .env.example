# Turtle — environment configuration (example)
#
# Copy this file to `.env` and fill in the keys you have.
# The app boots with ZERO keys: every provider has a documented fallback, so a
# missing secret degrades that capability instead of crashing the server.
#
#   DEEPGRAM_API_KEY                   missing => typed text input (text-in, voice-out)
#   ELEVENLABS_API_KEY                 missing => text-only mode (response shown, not spoken)
#   GEMINI_API_KEY / ANTHROPIC / OPENAI  all missing => canned orchestrator responses
#   (embeddings reuse GEMINI or OPENAI) none => lexical (keyword) retrieval over the KB

# --- Server ---
# HTTP + WebSocket port (default: 8787).
PORT=8787
# Passphrase used to derive the at-rest encryption key for transcripts, log
# entries, and contacts. If unset, an insecure DEV key is used (NOT for production).
TURTLE_ENCRYPTION_KEY=
# SQLite file path (default: ./data/turtle.sqlite).
TURTLE_DB_PATH=
# Look-ahead window (hours) before an appointment within which a session offers a
# prep briefing (default: 48). A session inside this window before an upcoming,
# time-parseable appointment is offered a purpose / what-to-report / questions briefing.
TURTLE_PREP_WINDOW_HOURS=48

# --- ASR: Deepgram (missing => text-in fallback) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# --- TTS: ElevenLabs (missing => text-only fallback) ---
# Voice settings and chunk schedule are frozen in packages/shared (TTS_PRESET).
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# One fixed voice, chosen once and frozen for MVP.
ELEVENLABS_VOICE_ID=
# pcm_16000 or pcm_24000.
ELEVENLABS_OUTPUT_FORMAT=pcm_16000

# --- LLM (provider-abstracted; missing all keys => canned responses) ---
# Optionally force a provider: gemini | anthropic | openai. If unset, Turtle
# auto-detects from whichever key is present (preferring Gemini).
#
# HIPAA note: for real caregivers with real PHI, use a BAA/HIPAA-eligible,
# no-training tier — applies to Gemini, Claude, and OpenAI alike.
LLM_PROVIDER=

# Gemini (recommended: Flash is fast + cheap, good for the per-turn safety classifier).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude (alternative).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OpenAI (alternative).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings (reuses GEMINI_API_KEY or OPENAI_API_KEY; else lexical fallback) ---
# Default model auto-selects: text-embedding-004 (Gemini) or text-embedding-3-small (OpenAI).
EMBEDDING_MODEL=

# --- Client ---
# Public URLs the browser uses to reach the server REST + WebSocket.
NEXT_PUBLIC_SERVER_URL=http://localhost:8787
NEXT_PUBLIC_SERVER_WS_URL=ws://localhost:8787
